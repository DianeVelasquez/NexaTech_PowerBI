{
  "name": "NexaTech",
  "dataColors": [
    "#1E6BFF",
    "#19C3FF",
    "#0A2FD6",
    "#7AA5FF",
    "#0B1220",
    "#94A3B8",
    "#5B8DEF",
    "#B8D4FF"
  ],
  "background": "#FFFFFF",
  "foreground": "#0B0F17",
  "tableAccent": "#1E6BFF",
  "good": "#22A06B",
  "neutral": "#F5A524",
  "bad": "#E5484D",
  "maximum": "#0A2FD6",
  "center": "#7AA5FF",
  "minimum": "#E6EEFF",
