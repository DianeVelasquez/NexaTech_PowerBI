    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#0B1220"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0B1220"
